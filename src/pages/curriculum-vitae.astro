---
import Page from '../layouts/Page.astro';
import Publications from '../components/Publications.astro';
import { education, experience, awards } from '../data/cv.js';
---
<Page title="Curriculum vitae" description="Eldar Hasanov’s education, experience, awards, and publications.">
  <h2>Education</h2>
  <ul class="listing">
    {education.map(item => (
      <li>
        <span class="period">{item.period} · {item.location}</span>
        <strong><a href={item.href}>{item.school}</a></strong>
        <p>{item.degree}</p>
      </li>
    ))}
  </ul>
  <h2>Experience</h2>
  <ul class="listing">
    {experience.map(item => (
      <li>
        <span class="period">{item.period} · {item.location}</span>
        <strong>{item.role}</strong>
        <p>{item.href ? <a href={item.href}>{item.org}</a> : item.org}</p>
        {item.detail && <p>{item.detail}</p>}
      </li>
    ))}
  </ul>
  <h2 id="awards">Awards</h2>
  <ul>
    {awards.map(award => <li><strong>{award.year}.</strong> {award.text}</li>)}
  </ul>
  <h2>Publications</h2>
  <Publications />
</Page>
